{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dtn-medical-mesh telemetry",
  "description": "One snapshot of the mesh for the live map (spec §10.3). Same shape from the emulator and from field TELEMETRY bundles.",
  "type": "object",
  "required": ["t", "geo", "speed", "paused", "nodes", "links", "lora", "transfers", "events", "stats"],
  "properties": {
    "t": {"type": "number", "description": "seconds since the scenario started"},
    "geo": {"type": ["array", "null"], "description": "[lat, lon] origin of x/y metres; null = schematic plane"},
    "speed": {"type": "number"},
    "paused": {"type": "boolean"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "sa", "x", "y", "up", "battery_pct", "shards", "used_bytes", "route", "hostile"],
        "properties": {
          "id": {"type": "string"},
          "role": {"enum": ["hub", "site", "mule", "relay"]},
          "sa": {"type": ["string", "null"]},
          "x": {"type": "number", "description": "metres, schematic plane (no basemap)"},
          "y": {"type": "number"},
          "up": {"type": "boolean"},
          "battery_pct": {"type": ["number", "null"]},
          "shards": {"type": "integer"},
          "used_bytes": {"type": "integer"},
          "route": {"type": ["array", "null"], "description": "waypoints [x, y] of a moving node"},
          "hostile": {"type": "boolean", "description": "emulator only: an attacker"}
        }
      }
    },
    "links": {"type": "array", "items": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2}},
    "lora": {"type": "array", "items": {"type": "string"}},
    "transfers": {"type": "array", "description": "custody receipts in the last few seconds", "items": {"type": "object", "required": ["t", "from", "to", "pieces", "bundles"]}},
    "events": {"type": "array", "items": {"type": "string"}, "description": "recent log lines, each starting with [hh:mm:ss]"},
    "stats": {
      "type": "object",
      "required": ["sent", "delivered", "in_transit", "not_delivered", "rejected"]
    }
  }
}
